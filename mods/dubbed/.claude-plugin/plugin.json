{
  "name": "dubbed",
  "version": "2026.11.1",
  "description": "Shows Claude's replies dubbed into Japanese or English, with the original folded below",
  "types": "./types/index.d.ts",
  "userConfig": {
    "lang": {
      "type": "string",
      "title": "Language",
      "description": "Language replies are dubbed into",
      "options": ["ja", "en"],
      "default": "ja"
    },
    "endpoint": {
      "type": "string",
      "title": "Completions endpoint",
      "description": "OpenAI-compatible /v1/completions URL serving PLaMo 3 Translate",
      "default": "http://127.0.0.1:9931/v1/completions"
    },
    "model": {
      "type": "string",
      "title": "Model",
      "description": "Model name the endpoint serves PLaMo 3 Translate under",
      "default": "plamo-3-translate-2b"
    }
  }
}
