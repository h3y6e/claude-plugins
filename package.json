{
  "name": "claude-plugins",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "aubr -r --if-present build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc && aubr -r typecheck"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.77.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
